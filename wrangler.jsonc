{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pogoda-seasync",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "pogoda.seasync.co", "custom_domain": true },
    { "pattern": "marine.weather.seasync.co", "custom_domain": true },
    { "pattern": "weather.seasync.co", "custom_domain": true },
    { "pattern": "www.weather.seasync.co", "custom_domain": true },
    { "pattern": "www.pogoda.seasync.co", "custom_domain": true }
  ],
  // Shared forecast store (one SQLite Durable Object) and the 5-minute pre-fetch.
  "durable_objects": {
    "bindings": [{ "name": "FORECAST_STORE", "class_name": "ForecastStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ForecastStore"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
